# Credenciais do broker MQTT dos rádios (usadas pelo relay de sincronização).
# Copie este arquivo para .env e preencha com os valores da sua operação.
# O arquivo .env NÃO é versionado.

MQTT_HOST=mqtt.legendariosrio.com.br
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Porta do relay WebSocket <-> MQTT
SYNC_PORT=8901
