{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://logistica.legendariosrio.com.br/v1/:path*"
    },
    {
      "source": "/ws",
      "destination": "https://logistica.legendariosrio.com.br/ws"
    },
    {
      "source": "/((?!assets/|logo.png|favicon.svg).*)",
      "destination": "/index.html"
    }
  ]
}
